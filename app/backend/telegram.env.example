# Copy to telegram.env and fill in values, then use "start with telegram.bat"

# From @BotFather → /newbot or existing bot token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot username without @ (for invite links: t.me/USERNAME?start=join_CODE)
TELEGRAM_BOT_USERNAME=YourMafiBot

# Public HTTPS URL where Mini App is hosted (required for Telegram Web App)
# Option A: ngrok — put ngrok.exe in tools\ and leave this empty (auto on start)
# Option B: your VPS/domain — e.g. https://mafi.example.com
MAFI_WEBAPP_URL=https://YOUR-PUBLIC-HTTPS-URL

# Optional server bind
MAFI_HOST=0.0.0.0
MAFI_PORT=8000
